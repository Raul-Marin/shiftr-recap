---
import type { Recap } from '../data/types';
import { recaps, upcomingSessions } from '../data';
import { withBase } from '../lib/paths';
import RecapLogo from './RecapLogo.astro';

interface Props {
  recap: Recap;
}

const { recap } = Astro.props;

const homeHref = withBase();
const logoSrc = withBase('logo.jpg');
const hasCharts = recap.charts.temas.data.length > 0;
const hasHeatmap = recap.heatmap.length > 0;
const kpiRows = [recap.kpis.slice(0, 4), recap.kpis.slice(4, 8)].filter((r) => r.length);
const valClass = { high: 'val-high', mid: 'val-mid', low: 'val-low' } as const;
const badgeClass = {
  critical: 'badge-critical',
  high: 'badge-high',
  low: 'badge-low',
  minimal: 'badge-minimal',
} as const;

function hexToRgba(hex: string, alpha: number) {
  const m = hex.replace('#', '');
  const r = parseInt(m.substring(0, 2), 16);
  const g = parseInt(m.substring(2, 4), 16);
  const b = parseInt(m.substring(4, 6), 16);
  return `rgba(${r},${g},${b},${alpha})`;
}

const allAvatars = ['avatar-1.png', 'avatar-2.png', 'avatar-3.png', 'avatar-4.png', 'avatar-5.png', 'avatar-6.png'];
const peopleAvatars =
  recap.number % 2 === 0 ? allAvatars.slice(2, 6) : [allAvatars[0], allAvatars[1], allAvatars[2], allAvatars[5]];

const sessions = [
  ...recaps
    .filter((r) => r.published)
    .map((r) => ({
      number: r.number,
      accent: r.accent,
      href: withBase(`${r.slug}/`),
      active: r.slug === recap.slug,
      upcoming: false,
    })),
  ...upcomingSessions.map((u) => ({
    number: u.number,
    accent: undefined,
    href: undefined,
    active: false,
    upcoming: true,
  })),
].sort((a, b) => a.number - b.number);
---

<nav class="nav">
  <div class="nav-left">
    <a class="nav-logo" href={homeHref}>
      <img src={logoSrc} alt="Shift+R" style="height:36px;width:36px;border-radius:8px;display:block;" />
    </a>

    {sessions.length > 1 && (
      <div class="session-switcher" aria-label="Sesiones Re/cap">
        {sessions.map((s) =>
          s.upcoming ? (
            <span class="session-tab upcoming" title="Próximamente">
              <span class="session-tab__dot" />
              {String(s.number).padStart(2, '0')}
            </span>
          ) : (
            <a
              href={s.href}
              class:list={['session-tab', { active: s.active }]}
              aria-current={s.active ? 'page' : undefined}
              style={`--tab-accent:${s.accent}`}
            >
              <span class="session-tab__dot" />
              {String(s.number).padStart(2, '0')}
            </a>
          )
        )}
      </div>
    )}
  </div>

  <ul class="nav-links">
    <li><a href="#signals"><span class="nav-links__num">01</span><span class="nav-links__label">Señales</span></a></li>
    {hasHeatmap && (
      <li><a href="#emotions"><span class="nav-links__num">02</span><span class="nav-links__label">Carga emocional</span></a></li>
    )}
    <li><a href="#tensions"><span class="nav-links__num">03</span><span class="nav-links__label">Tensiones</span></a></li>
    <li><a href="#voices"><span class="nav-links__num">04</span><span class="nav-links__label">Voces</span></a></li>
    <li><a href="#insights"><span class="nav-links__num">05</span><span class="nav-links__label">Hallazgos</span></a></li>
    <li><a href="#recs"><span class="nav-links__num">06</span><span class="nav-links__label">Próximos pasos</span></a></li>
  </ul>
  <a class="nav-cta" href="#recs">{recap.navCta}</a>
</nav>

<div class="hero">
  <div class="hero-top-row">
    {recap.cover && (
      <div class="hero-detail">
        <img src={withBase(`images/${recap.cover}`)} alt="" loading="lazy" />
      </div>
    )}
    <div class="hero-label">
      <RecapLogo class="recap-logo-anim" width={36} height={16} animated />
      {recap.heroLabel}
    </div>
  </div>
  <h1>{recap.headline}<br /><em set:html={recap.headlineEm} /></h1>
  <p class="hero-sub" set:html={recap.subtitleHtml} />
  <div class="hero-meta">
    {recap.meta.map((item) =>
      item.label === 'Participantes' ? (
        <div class="hero-meta-item">
          <span class="hero-meta-label">{item.label}</span>
          <div class="hero-meta-people">
            <div class="hero-meta-avatars">
              {peopleAvatars.map((a) => (
                <img src={withBase(`images/avatars/${a}`)} alt="" loading="lazy" />
              ))}
            </div>
            <span class="hero-meta-value">{item.value}</span>
          </div>
        </div>
      ) : (
        <div class="hero-meta-item">
          <span class="hero-meta-label">{item.label}</span>
          <span class="hero-meta-value">{item.value}</span>
        </div>
      )
    )}
  </div>
</div>

{
  recap.resources && (
    <div class="resources-wrap">
      <div
        class="resources-card"
        style={`--card-accent:${recap.accent};--card-tint:${hexToRgba(recap.accent, 0.14)}`}
      >
        <div class="resources-card__eyebrow">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="#4285F4" aria-hidden="true">
            <path d="M11.999 3.201C5.372 3.201 0 8.528 0 15.101V20.8h2.212v-.568c0-2.666 2.178-4.827 4.866-4.827 2.688 0 4.866 2.16 4.866 4.827v.568h2.212v-.568c0-3.877-3.17-7.019-7.078-7.019A7.075 7.075 0 0 0 2.992 14.5a7.355 7.355 0 0 1 6.568-4.016c4.057 0 7.347 3.264 7.347 7.287V20.8h2.212V17.77c0-5.235-4.28-9.481-9.56-9.481a9.563 9.563 0 0 0-6.217 2.28A9.795 9.795 0 0 1 12 5.393c5.406 0 9.788 4.346 9.788 9.707V20.8H24V15.1c-.001-6.573-5.373-11.9-12.001-11.9Z" />
          </svg>
          Generado con NotebookLM
        </div>

        <div class="resources-card__grid">
          {recap.resources.audioSrc && (
            <div class="resource-audio">
              <div class="resource-audio__label">
                <span class="resource-audio__icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 18v-6a9 9 0 0 1 18 0v6" />
                    <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z" />
                  </svg>
                </span>
                <span class="resource-audio__text">
                  <span class="resource-audio__kicker">Audio podcast</span>
                  <span class="resource-audio__title">{recap.resources.audioLabel ?? 'Escucha el resumen'}</span>
                </span>
              </div>
              <audio controls preload="none" src={withBase(`audio/${recap.resources.audioSrc}`)}>
                Tu navegador no soporta la reproducción de audio.
              </audio>
            </div>
          )}

          {(recap.resources.notebookUrl || recap.resources.infographicSrc) && (
            <div class="resource-links">
              {recap.resources.notebookUrl && (
                <a class="resource-link" href={recap.resources.notebookUrl} target="_blank" rel="noopener">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                    <path d="M12 8v4M12 16h.01" />
                  </svg>
                  Pregunta al cuaderno
                </a>
              )}
              {recap.resources.infographicSrc && (
                <a class="resource-link" href={withBase(`images/${recap.resources.infographicSrc}`)} target="_blank" rel="noopener">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <circle cx="8.5" cy="8.5" r="1.5" />
                    <path d="m21 15-5-5L5 21" />
                  </svg>
                  Ver infografía resumen
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    </div>
  )
}

<hr class="section-divider" />

{
  (recap.ideSignals.length > 0 || recap.kpis.length > 0) && (
    <div class="section" id="signals">
      <div class="section-label">01 · Señales de la sesión</div>
      <h2 class="section-title">El estado del grupo</h2>
      <p class="section-desc">
        Intensidad de señales emocionales y profesionales detectadas. Escala 1–5 según frecuencia e intensidad de
        mención en sesión.
      </p>

      {recap.ideSignals.length > 0 && (
        <div class="ide-block">
          <span class="comment">{recap.ideHeader}</span>
          <br /><br />
          {recap.ideSignals.map((s) => (
            <>
              <span class="key">{s.key.padEnd(18, ' ')}</span>
              {' = '}
              <span class={valClass[s.level]}>{s.value}</span>
              {'  '}
              <span class="comment">{s.comment}</span>
              <br />
            </>
          ))}
        </div>
      )}

      {kpiRows.map((row) => (
        <div class="kpi-grid">
          {row.map((kpi) => (
            <div class:list={['kpi-card', { dark: !!kpi.dark }]}>
              <span class="kpi-label">{kpi.label}</span>
              <div class="kpi-value">
                {kpi.value}<sup>/5</sup>
              </div>
              <div class="kpi-note">{kpi.note}</div>
              {kpi.badge && (
                <span class:list={['badge', badgeClass[kpi.badge.tone]]}>{kpi.badge.text}</span>
              )}
            </div>
          ))}
        </div>
      ))}

      {hasCharts && (
        <div class="charts-row">
          <div class="chart-card">
            <div class="chart-title">Frecuencia de temas · menciones relativas</div>
            <div class="chart-wrap" style="height:260px;">
              <canvas
                id="temaChart"
                role="img"
                aria-label="Frecuencia de temas en la sesión"
                data-chart="temas"
              >
                {recap.charts.temas.fallback}
              </canvas>
            </div>
          </div>
          <div class="chart-card">
            <div class="chart-title">Necesidades detectadas · prioridad percibida</div>
            <div class="chart-wrap" style="height:260px;">
              <canvas
                id="radarChart"
                role="img"
                aria-label="Radar de necesidades del grupo"
                data-chart="radar"
              >
                {recap.charts.radar.fallback}
              </canvas>
            </div>
          </div>
        </div>
      )}
    </div>
  )
}

{
  recap.heatmap.length > 0 && (
    <>
      <hr class="section-divider" />
      <div class="section" id="emotions">
        <div class="section-label">02 · Mapa de carga emocional</div>
        <h2 class="section-title">¿Qué está en tensión?</h2>
        <p class="section-desc">
          Cada celda es un tema emergente de la sesión. El color indica la carga emocional detectada en el discurso.
        </p>

        <div class="timeline-row">
          <span class="tl-pill tl-thinking">Crítica</span>
          <span class="tl-pill tl-thinking" style="opacity:.7">Alta</span>
          <span class="tl-pill tl-done">Media</span>
          <span class="tl-pill tl-grep">Baja</span>
          <span class="tl-pill" style="background:var(--surface-strong);color:var(--muted)">Neutra</span>
        </div>

        <div class="heatmap-grid">
          {recap.heatmap.map((cell) => (
            <div class={`hm-cell hm-${cell.level}`}>
              <span>{cell.label}</span>
            </div>
          ))}
        </div>
        <div class="hm-legend">
          <span class="hm-dot" style="background:#c43010"></span> Crítica &nbsp;
          <span class="hm-dot" style="background:var(--tl-thinking)"></span> Alta &nbsp;
          <span class="hm-dot" style="background:var(--tl-done)"></span> Media &nbsp;
          <span class="hm-dot" style="background:var(--tl-grep)"></span> Baja &nbsp;
          <span class="hm-dot" style="background:var(--surface-strong)"></span> Neutra
        </div>
      </div>
    </>
  )
}

{
  recap.tensions.length > 0 && (
    <>
      <hr class="section-divider" />
      <div class="section" id="tensions">
        <div class="section-label">03 · Tensiones identificadas</div>
        <h2 class="section-title">Las seis contradicciones del momento</h2>
        <p class="section-desc">
          Pares de conceptos en conflicto que emergieron con mayor fuerza y frecuencia durante el debate.
        </p>

        <div class="tension-grid">
          {recap.tensions.map((t) => (
            <div class="tension-card">
              <div class="tension-pill">
                <span class={`tl-pill tl-${t.level}`}>{t.levelLabel}</span>
              </div>
              <div class="tension-vs">
                <span class="tension-term">{t.left}</span>
                <span class="tension-sep">vs</span>
                <span class="tension-term">{t.right}</span>
              </div>
              <p class="tension-desc">{t.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </>
  )
}

{
  recap.verbatims.length > 0 && (
    <>
      <hr class="section-divider" />
      <div class="section" id="voices">
        <div class="section-label">04 · Verbatim</div>
        <h2 class="section-title">Lo que se dijo en sesión</h2>
        <p class="section-desc">
          Frases literales que condensan el clima emocional y profesional. Los nombres han sido anonimizados.
        </p>

        <div class="verbatim-list">
          {recap.verbatims.map((v) => (
            <div class="verbatim-item">
              <div class="verbatim-text">{v.text}</div>
              <div class="verbatim-tag">
                <span class={`tl-pill tl-${v.tone}`}>{v.tag}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </>
  )
}

{
  recap.insights.length > 0 && (
    <>
      <hr class="section-divider" />
      <div class="section" id="insights">
        <div class="section-label">05 · Hallazgos clave</div>
        <h2 class="section-title">Qué aprendimos</h2>
        <p class="section-desc">Seis hallazgos accionables que emergen del análisis cualitativo de la sesión.</p>

        <div class="insight-grid">
          {recap.insights.map((insight) => (
            <div class="insight-card">
              <div class="insight-num">{insight.num}</div>
              <div class="insight-title">{insight.title}</div>
              <p class="insight-body">{insight.body}</p>
            </div>
          ))}
        </div>
      </div>
    </>
  )
}

<div class="cta-band" id="recs">
  <h2>
    {recap.cta.title}
    <em set:html={`<br>${recap.cta.titleEm}`} />
  </h2>
  <p>{recap.cta.body}</p>

  {recap.cta.recs.length > 0 && (
    <div class="recs-grid">
      {recap.cta.recs.map((rec) => (
        <div class="rec-card">
          <span class="rec-label">{rec.label}</span>
          <p class="rec-text">{rec.text}</p>
        </div>
      ))}
    </div>
  )}
</div>

<footer>
  <span class="footer-logo">
    <img
      src={logoSrc}
      alt="Shift+R"
      style="height:32px;width:32px;border-radius:6px;display:inline-block;vertical-align:middle;"
    />
  </span>
  <span class="footer-meta">{recap.footerMeta}</span>
</footer>

{
  hasCharts && (
    <>
      <script
        id="chart-data"
        type="application/json"
        set:html={JSON.stringify({
          temas: {
            labels: recap.charts.temas.labels,
            data: recap.charts.temas.data,
            colors: recap.charts.temas.colors,
          },
          radar: {
            labels: recap.charts.radar.labels,
            data: recap.charts.radar.data,
          },
          accent: recap.accent,
        })}
      />
      <script>
        import { Chart } from 'chart.js/auto';

        const raw = document.getElementById('chart-data')?.textContent;
        if (!raw) throw new Error('Missing chart data');
        const { temas, radar, accent } = JSON.parse(raw);

        const body = '#5a5852';
        const muted = '#807d72';
        const grid = '#e6e5e0';
        const orange = accent || '#ffdd00';

        function hexToRgba(hex: string, alpha: number) {
          const m = hex.replace('#', '');
          const r = parseInt(m.substring(0, 2), 16);
          const g = parseInt(m.substring(2, 4), 16);
          const b = parseInt(m.substring(4, 6), 16);
          return `rgba(${r},${g},${b},${alpha})`;
        }

        new Chart(document.getElementById('temaChart'), {
          type: 'bar',
          data: {
            labels: temas.labels,
            datasets: [
              {
                data: temas.data,
                backgroundColor: temas.colors,
                borderWidth: 0,
                borderRadius: 4,
              },
            ],
          },
          options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false },
              tooltip: { callbacks: { label: (ctx) => ` ${ctx.raw}%` } },
            },
            scales: {
              x: {
                max: 100,
                ticks: {
                  color: muted,
                  font: { size: 11, family: 'Inter' },
                  callback: (v) => v + '%',
                },
                grid: { color: grid },
                border: { display: false },
              },
              y: {
                ticks: { color: body, font: { size: 11, family: 'Inter' } },
                grid: { display: false },
                border: { display: false },
              },
            },
          },
        });

        new Chart(document.getElementById('radarChart'), {
          type: 'radar',
          data: {
            labels: radar.labels,
            datasets: [
              {
                data: radar.data,
                backgroundColor: hexToRgba(orange, 0.12),
                borderColor: orange,
                borderWidth: 1.5,
                pointBackgroundColor: orange,
                pointRadius: 3,
              },
            ],
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
              r: {
                min: 0,
                max: 5,
                ticks: {
                  stepSize: 1,
                  color: muted,
                  font: { size: 10, family: 'Inter' },
                  backdropColor: 'transparent',
                },
                grid: { color: grid },
                angleLines: { color: grid },
                pointLabels: { color: body, font: { size: 11, family: 'Inter' } },
              },
            },
          },
        });
      </script>
    </>
  )
}

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-links a'));
  const targets = links
    .map((link) => {
      const id = link.getAttribute('href')?.slice(1);
      const el = id ? document.getElementById(id) : null;
      return el ? { link, el } : null;
    })
    .filter((t): t is { link: HTMLAnchorElement; el: HTMLElement } => t !== null);

  if (targets.length) {
    const setActive = (id: string) => {
      links.forEach((l) => l.classList.toggle('active', l.getAttribute('href') === `#${id}`));
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive(entry.target.id);
        });
      },
      { rootMargin: '-15% 0px -50% 0px', threshold: 0 }
    );

    targets.forEach(({ el }) => observer.observe(el));
  }
</script>
