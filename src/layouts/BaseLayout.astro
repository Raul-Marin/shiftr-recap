---
import '../styles/global.css';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  /** Per-session accent color, overrides --primary/--primary-active so each recap reads as distinct. */
  accent?: string;
  accentActive?: string;
}

const { title, accent, accentActive } = Astro.props;
const accentStyle = accent
  ? `--primary:${accent};--primary-active:${accentActive ?? accent};`
  : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={withBase('favicon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body style={accentStyle}>
    <slot />
    <script>
      const REVEAL_SELECTOR =
        '.hero, .hero-meta, .section, .kpi-card, .chart-card, .tension-card, .insight-card, .rec-card, .verbatim-item, .heatmap-grid, .cta-band, .session-card, .upcoming-badge, .session-switcher';

      const els = Array.from(document.querySelectorAll<HTMLElement>(REVEAL_SELECTOR));

      if (els.length && 'IntersectionObserver' in window) {
        els.forEach((el) => el.classList.add('reveal'));

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('reveal-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
        );

        els.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
