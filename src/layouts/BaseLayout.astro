---
import '../styles/global.css';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  /** Per-session accent color, overrides --primary/--primary-active so each recap reads as distinct. */
  accent?: string;
  accentActive?: string;
}

const { title, accent, accentActive } = Astro.props;
const accentStyle = accent
  ? `--primary:${accent};--primary-active:${accentActive ?? accent};`
  : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={withBase('favicon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body style={accentStyle}>
    <slot />
  </body>
</html>
